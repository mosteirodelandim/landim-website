---
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import QuoteBlock from "@/components/QuoteBlock.astro";
import SpotlightLink from "@/components/SpotlightLink.astro";
import Lightbox from "@/components/Lightbox.astro";
import SmartImage from "@/components/SmartImage.astro";
import { t } from "@/i18n";
import { config } from "@/config";

import banner from "@/assets/images/photo-gallery/banner.png";

const c = t.photoGallery;

/* ---- Collect chapter images at build time ---- */
type GlobMap = Record<string, { default: ImageMetadata }>;

const byNumber = (globbed: GlobMap): ImageMetadata[] =>
  Object.entries(globbed)
    .sort(([a], [b]) => {
      const num = (p: string) => parseInt(p.split("/").pop() ?? "0", 10);
      return num(a) - num(b);
    })
    .map(([, mod]) => mod.default);

const gardenImgs = byNumber(
  import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/photo-gallery/garden/*",
    { eager: true },
  ),
);
const cloisterImgs = byNumber(
  import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/photo-gallery/cloister/*",
    { eager: true },
  ),
);
const roomsImgs = byNumber(
  import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/photo-gallery/rooms/*",
    { eager: true },
  ),
);
const churchImgs = byNumber(
  import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/photo-gallery/church/*",
    { eager: true },
  ),
);

interface Chapter {
  id: string;
  index: string;
  title: string;
  description: string;
  images: ImageMetadata[];
  fulls: string[];
}

async function fulls(images: ImageMetadata[]): Promise<string[]> {
  const out = await Promise.all(
    images.map((src) =>
      getImage({ src, width: Math.min(1800, src.width), format: "webp", quality: 78 }),
    ),
  );
  return out.map((o) => o.src);
}

const chapters: Chapter[] = [
  {
    id: "jardins",
    index: "01",
    title: c.gardenTitle,
    description: c.gardenDescription,
    images: gardenImgs,
    fulls: await fulls(gardenImgs),
  },
  {
    id: "claustro",
    index: "02",
    title: c.cloisterTitle,
    description: c.cloisterDescription,
    images: cloisterImgs,
    fulls: await fulls(cloisterImgs),
  },
  {
    id: "salas",
    index: "03",
    title: c.roomsTitle,
    description: c.roomsDescription,
    images: roomsImgs,
    fulls: await fulls(roomsImgs),
  },
  {
    id: "igreja",
    index: "04",
    title: c.churchTitle,
    description: c.churchDescription,
    images: churchImgs,
    fulls: await fulls(churchImgs),
  },
];

const gallerySizes = "(min-width: 84rem) 56rem, (min-width: 48rem) 60vw, 50vw";

// Line-art glyphs for the floating chapter nav (24x24 viewBox).
const galleryIcons: Record<string, string> = {
  jardins: `<path d="M12 4 C18 8 18 17 12 21 C6 17 6 8 12 4 Z M12 6 L12 20 M12 12 L8 9 M12 15 L16 11" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  claustro: `<path d="M4 20 L4 9 Q4 5 8 5 Q12 5 12 9 L12 20 M12 20 L12 9 Q12 5 16 5 Q20 5 20 9 L20 20 M3 20 L21 20" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  salas: `<path d="M4 20 L4 7 L12 3 L20 7 L20 20 M3 20 L21 20 M9 20 L9 13 L15 13 L15 20" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  igreja: `<path d="M12 2 L12 6 M10 4 L14 4 M6 21 L6 10 L12 6 L18 10 L18 21 M4 21 L20 21 M10 21 L10 16 Q12 14 14 16 L14 21" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
};
---

<BaseLayout title={c.title} description={c.subHeading}>
  <PageHero
    title={c.title}
    subtitle={c.subHeading}
    image={banner}
    imageAlt="Recantos do Mosteiro de Landim"
    label="Galeria"
  />

  <!-- ============ INTRO ============ -->
  <section class="section">
    <div class="container intro-grid">
      <QuoteBlock quote={c.quote} author={c.quoteAuthor} />
      <p class="intro-text" data-reveal="fade-up">{c.paragraph.description1}</p>
    </div>

    <nav class="chapter-nav container" aria-label="Capítulos da galeria" data-reveal="stagger-children">
      {
        chapters.map((ch) => (
          <a href={`#${ch.id}`} class="chapter-nav-link">
            <span class="label">{ch.index}</span>
            <span class="chapter-nav-name serif-italic">{ch.title}</span>
            <span class="chapter-nav-count label">{ch.images.length} fotografias</span>
          </a>
        ))
      }
    </nav>
  </section>

  <!-- ============ CHAPTERS ============ -->
  {
    chapters.map((ch) => (
      <section class="chapter" id={ch.id} aria-labelledby={`${ch.id}-title`}>
        <header class="container chapter-header">
          <p class="label chapter-index" data-reveal="fade-up">
            Capítulo {ch.index}
          </p>
          <h2 class="chapter-title" id={`${ch.id}-title`} data-reveal="fade-up">
            {ch.title}
          </h2>
          <p class="chapter-desc" data-reveal="fade-up">
            {ch.description}
          </p>
        </header>

        <ul class="masonry container--wide">
          {ch.images.map((img, i) => (
            <li class="masonry-item" data-reveal="fade-up">
              <a
                href={ch.fulls[i]}
                data-lightbox={ch.id}
                data-caption={`${ch.title} — ${i + 1} / ${ch.images.length}`}
                aria-label={`Ampliar fotografia ${i + 1} de ${ch.title}`}
              >
                <SmartImage
                  src={img}
                  alt={`${ch.title} do Mosteiro de Landim — fotografia ${i + 1}`}
                  sizes={gallerySizes}
                  widths={[400, 700, 1100, 1500]}
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <!-- ============ FLOATING CHAPTER NAV ============ -->
  <nav class="gallery-float" aria-label="Capítulos da galeria" data-gallery-float>
    <ul>
      {
        chapters.map((ch) => (
          <li>
            <a href={`#${ch.id}`} class="gallery-float-link" data-float-link={ch.id}>
              <span class="gallery-float-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" set:html={galleryIcons[ch.id] ?? ""} />
              </span>
              <span class="gallery-float-name serif-italic">{ch.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <SpotlightLink
    label={c.spotlight.title}
    text={c.spotlight.description}
    cta="Seguir no Instagram"
    href={config.socialLinks[0].url}
    external
    icon="social"
  />

  <Lightbox />
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-xl);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
  }

  .intro-text {
    color: var(--fg-soft);
  }

  /* Chapter index nav */
  .chapter-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }

  .chapter-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-sm) 0.4rem 0;
    text-decoration: none;
    border-top: 2px solid transparent;
    margin-top: -1px;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .chapter-nav-link:hover {
    border-top-color: var(--clay);
  }

  .chapter-nav-link > .label {
    color: var(--gold-ink);
  }

  .chapter-nav-name {
    font-size: var(--text-lg);
    color: var(--fg);
  }

  .chapter-nav-count {
    color: var(--fg-soft);
    letter-spacing: 0.18em;
  }

  /* Chapters */
  .chapter {
    padding-block: var(--space-lg);
    scroll-margin-top: 4.5rem;
  }

  .chapter:nth-of-type(even) {
    background: var(--bg-alt);
    border-block: 1px solid var(--hairline);
  }

  .chapter-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .chapter-index {
    color: var(--clay-deep);
  }

  .chapter-title {
    font-size: var(--text-2xl);
    font-weight: 400;
  }

  .chapter-desc {
    color: var(--fg-soft);
    max-width: 60ch;
  }

  /* ---- Editorial masonry ----
     12-col grid, deterministic repeating 6-pattern, dense flow. */
  .masonry {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: min(100% - 2 * var(--gutter), var(--container-wide));
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(0.7rem, 1.6vw, 1.4rem);
  }

  .masonry-item a {
    display: block;
    height: 100%;
  }

  .masonry-item :global(.smart-image) {
    height: 100%;
    border-radius: var(--radius-sm);
  }

  .masonry-item :global(.smart-image img) {
    transition: transform 1.1s var(--ease-out), opacity 700ms var(--ease-out);
  }

  .masonry-item:hover :global(.smart-image img) {
    transform: scale(1.045);
  }

  /* Repeating editorial pattern */
  .masonry-item:nth-child(6n + 1) {
    grid-column: span 7;
  }
  .masonry-item:nth-child(6n + 1) :global(.smart-image) {
    aspect-ratio: 3 / 2 !important;
  }

  .masonry-item:nth-child(6n + 2) {
    grid-column: span 5;
  }
  .masonry-item:nth-child(6n + 2) :global(.smart-image) {
    aspect-ratio: 4 / 5 !important;
  }

  .masonry-item:nth-child(6n + 3) {
    grid-column: span 4;
  }
  .masonry-item:nth-child(6n + 3) :global(.smart-image) {
    aspect-ratio: 1 / 1 !important;
  }

  .masonry-item:nth-child(6n + 4) {
    grid-column: span 8;
  }
  .masonry-item:nth-child(6n + 4) :global(.smart-image) {
    aspect-ratio: 16 / 9 !important;
  }

  .masonry-item:nth-child(6n + 5) {
    grid-column: span 5;
  }
  .masonry-item:nth-child(6n + 5) :global(.smart-image) {
    aspect-ratio: 4 / 5 !important;
  }

  .masonry-item:nth-child(6n + 6) {
    grid-column: span 7;
  }
  .masonry-item:nth-child(6n + 6) :global(.smart-image) {
    aspect-ratio: 3 / 2 !important;
  }

  /* ---- Floating chapter nav ---- */
  .gallery-float {
    position: fixed;
    top: 50%;
    right: clamp(0.6rem, 2vw, 1.4rem);
    z-index: 40;
    transform: translateY(-50%) translateX(1.5rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility var(--dur-base) var(--ease-out);
  }

  .gallery-float.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0);
  }

  .gallery-float ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--hairline);
    border-radius: 2rem;
    box-shadow: 0 10px 30px rgb(49 43 35 / 0.12);
  }

  .gallery-float-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--fg-soft);
    border-radius: 1.4rem;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .gallery-float-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
  }

  .gallery-float-icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .gallery-float-name {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    font-size: var(--text-sm);
    transition:
      max-width var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      padding-right var(--dur-base) var(--ease-out);
  }

  .gallery-float-link:hover {
    color: var(--clay-deep);
    background: color-mix(in srgb, var(--clay) 10%, transparent);
  }

  .gallery-float-link:hover .gallery-float-name {
    max-width: 12rem;
    opacity: 1;
    padding-right: 1rem;
  }

  .gallery-float-link.is-active {
    color: var(--linen);
    background: var(--clay);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-float,
    .gallery-float-name {
      transition: none;
    }
  }

  /* ---- Mobile: simple 2-col grid ---- */
  @media (max-width: 48rem) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .gallery-float {
      top: auto;
      bottom: 1rem;
      right: 50%;
      transform: translateX(50%) translateY(1.5rem);
    }

    .gallery-float.is-visible {
      transform: translateX(50%) translateY(0);
    }

    .gallery-float ul {
      flex-direction: row;
    }

    .chapter-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .masonry {
      gap: 0.55rem;
    }

    .masonry-item,
    .masonry-item:nth-child(6n + 1),
    .masonry-item:nth-child(6n + 2),
    .masonry-item:nth-child(6n + 3),
    .masonry-item:nth-child(6n + 4),
    .masonry-item:nth-child(6n + 5),
    .masonry-item:nth-child(6n + 6) {
      grid-column: span 6;
    }

    .masonry-item :global(.smart-image) {
      aspect-ratio: 1 / 1 !important;
    }

    .masonry-item:hover :global(.smart-image img) {
      transform: none;
    }
  }
</style>

<script>
  function initGalleryNav() {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      ".chapter-nav-link, .gallery-float-link",
    );
    if (!links.length) return;

    links.forEach((link) => {
      if (link.dataset.bound) return;
      link.dataset.bound = "true";

      link.addEventListener("click", (e) => {
        const id = link.getAttribute("href")?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        const lenis = (window as unknown as Record<string, unknown>).__lenis as { scrollTo?: (el: Element, opts?: Record<string, unknown>) => void } | undefined;
        if (lenis?.scrollTo) {
          lenis.scrollTo(target, { offset: -72, duration: 1.2, easing: (t: number) => 1 - Math.pow(1 - t, 3) });
        } else {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    // Floating widget: active highlight + reveal-on-scroll
    const widget = document.querySelector<HTMLElement>("[data-gallery-float]");
    const chapters = Array.from(document.querySelectorAll<HTMLElement>(".chapter"));
    if (!widget || !chapters.length || widget.dataset.ioBound) return;
    widget.dataset.ioBound = "true";

    const floatLinks = new Map<string, HTMLElement>();
    widget.querySelectorAll<HTMLElement>(".gallery-float-link").forEach((l) => {
      const id = l.dataset.floatLink;
      if (id) floatLinks.set(id, l);
    });

    const activeIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = (entry.target as HTMLElement).id;
          floatLinks.forEach((l, key) => l.classList.toggle("is-active", key === id));
        });
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    chapters.forEach((ch) => activeIO.observe(ch));

    // Show the widget once the first chapter is reached, hide above it.
    const first = chapters[0];
    const visIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const past = entry.boundingClientRect.top < 1 || entry.isIntersecting;
          widget.classList.toggle("is-visible", past);
        });
      },
      { threshold: 0 },
    );
    visIO.observe(first);
  }

  initGalleryNav();
  document.addEventListener("astro:page-load", initGalleryNav);
</script>
