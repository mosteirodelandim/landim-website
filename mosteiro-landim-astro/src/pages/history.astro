---
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import GalleryStrip from "@/components/GalleryStrip.astro";
import Lightbox from "@/components/Lightbox.astro";
import SmartImage from "@/components/SmartImage.astro";
import { getContent, resolveLocale } from "@/i18n";

import banner from "@/assets/images/history/banner.jpg";
import origins1 from "@/assets/images/history/origins_architecture/pic1.jpg";
import origins2 from "@/assets/images/history/origins_architecture/pic2.jpg";
import origins3 from "@/assets/images/history/origins_architecture/pic3.jpg";
import origins4 from "@/assets/images/history/origins_architecture/pic4.jpg";
import origins5 from "@/assets/images/history/origins_architecture/pic5.jpg";
import origins6 from "@/assets/images/history/origins_architecture/pic6.jpg";
import origins7 from "@/assets/images/history/origins_architecture/pic7.jpg";
import origins8 from "@/assets/images/history/origins_architecture/pic8.jpg";
import priests1 from "@/assets/images/history/priests/pic1.jpg";
import priests2 from "@/assets/images/history/priests/pic2.jpg";
import sale1 from "@/assets/images/history/sale/picture1.jpg";
import sale2 from "@/assets/images/history/sale/picture2.jpg";
import camilo1 from "@/assets/images/history/notable_people/camilo.jpg";
import camilo2 from "@/assets/images/history/notable_people/camilo2.jpg";
import camilo3 from "@/assets/images/history/notable_people/camilo3.jpg";
import alberto1 from "@/assets/images/history/notable_people/alberto1.jpg";
import alberto2 from "@/assets/images/history/notable_people/alberto2.jpg";
import sebastiao1 from "@/assets/images/history/notable_people/sebastiao1.jpg";
import book1 from "@/assets/images/history/book/book1.jpg";
import bookOld from "@/assets/images/history/book/book_old.jpg";

const locale = resolveLocale(Astro.currentLocale);
const c = getContent(locale).history;

/* ---- chapters nav ---- */const chapters = [
  { id: "origins", label: c.origins_architecture.title },
  { id: "priests", label: c.priests_commissioners.title },
  { id: "extinction", label: c.extinction.title },
  { id: "sale", label: c.sale.title },
  { id: "notable", label: c.notable_people.title },
  { id: "book", label: c.book.title },
];

/* ---- figures ---- */
interface Fig {
  img: ImageMetadata;
  caption: string;
  full: string;
}

async function figs(images: ImageMetadata[], captions: string[]): Promise<Fig[]> {
  const out = await Promise.all(
    images.map((src) =>
      getImage({ src, width: Math.min(1700, src.width), format: "webp", quality: 78 }),
    ),
  );
  return images.map((img, i) => ({ img, caption: captions[i] ?? "", full: out[i].src }));
}

const oc = c.origins_architecture.imagesCaptions;
const originsFigs = await figs(
  [origins1, origins2, origins3, origins4, origins5, origins6, origins7, origins8],
  [oc.picture1, oc.picture2, oc.picture3, oc.picture4, oc.picture5, oc.picture6, oc.picture7, oc.picture8],
);

const pc = c.priests_commissioners.imagesCaptions;
const priestsFigs = await figs([priests1, priests2], [pc.picture1, pc.picture2]);

const sc = c.sale.imagesCaptions;
const saleFigs = await figs([sale1, sale2], [sc.picture1, sc.picture2]);

/* ---- extinction scans (filmstrips) ---- */
const ec = c.extinction.imagesCaptions as Record<string, string>;

const byNumber = (globbed: Record<string, { default: ImageMetadata }>, stem: string) =>
  Object.entries(globbed)
    .filter(([p]) => p.includes(stem))
    .sort(([a], [b]) => {
      const num = (p: string) => parseInt((p.split("/").pop() ?? "").replace(/\D/g, ""), 10);
      return num(a) - num(b);
    })
    .map(([, mod]) => mod.default);

const extinctionGlob = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/history/extinction/*",
  { eager: true },
);

const breveImgs = byNumber(extinctionGlob, "Breve");
const receitaImgs = byNumber(extinctionGlob, "Receita");

const breveItems = breveImgs.map((src, i) => ({ src, caption: ec[`breve${i + 1}`] ?? "" }));
const receitaItems = receitaImgs.map((src, i) => ({ src, caption: ec[`receita${i + 1}`] ?? "" }));

/* ---- notable people ---- */
const nc = c.notable_people.imagesCaptions;
const camiloCaptions = [nc.camilo1, nc.camilo2, nc.camilo3];
const camiloFigs = await figs([camilo1, camilo2, camilo3], camiloCaptions);
const albertoFigs = await figs([alberto1, alberto2], [nc.alberto4, nc.alberto5]);
const sebastiaoFigs = await figs([sebastiao1], [nc.sebastiao6]);

const bookFull = await getImage({ src: book1, width: 1400, format: "webp", quality: 80 });
---

<BaseLayout title={c.title} description={c.subHeading}>
  <PageHero
    title={c.title}
    subtitle={c.subHeading}
    image={banner}
    imageAlt={c.ui.heroAlt}
    label={c.ui.heroLabel}
  />

  <div class="history-layout container--wide">
    <!-- ============ STICKY CHAPTER NAV ============ -->
    <nav class="chapters-nav" aria-label={c.ui.chaptersNavLabel}>
      <p class="label chapters-nav-title">{c.ui.chaptersTitle}</p>
      <ol id="chapters-list">
        {
          chapters.map((ch, i) => (
            <li>
              <a href={`#${ch.id}`} data-chapter={ch.id}>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                {ch.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="chapters-content">
      <!-- ============ 01 ORIGENS ============ -->
      <section class="chapter" id="origins" aria-labelledby="origins-title">
        <header class="chapter-head">
          <p class="label" data-reveal="fade-up">{c.ui.chapterWord} 01</p>
          <h2 id="origins-title" data-reveal="fade-up">{c.origins_architecture.title}</h2>
          <p class="chapter-lede serif-italic" data-reveal="fade-up">
            {c.origins_architecture.subHeading}
          </p>
        </header>
        <div class="chapter-prose prose-drop" data-reveal="fade-up">
          <p set:html={c.origins_architecture.description1} />
          <p set:html={c.origins_architecture.description2} />
          <p set:html={c.origins_architecture.description3} />
        </div>
        <div class="fig-grid">
          {
            originsFigs.map((f) => (
              <figure class="fig" data-reveal="fade-up">
                <a href={f.full} data-lightbox="origins" data-caption={f.caption}>
                  <SmartImage
                    src={f.img}
                    alt={f.caption}
                    sizes="(min-width: 64rem) 26rem, 92vw"
                    widths={[400, 700, 1100]}
                    aspect="4 / 3"
                  />
                </a>
                <figcaption class="fig-caption serif-italic">{f.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ============ 02 PRIORES ============ -->
      <section class="chapter" id="priests" aria-labelledby="priests-title">
        <header class="chapter-head">
          <p class="label" data-reveal="fade-up">{c.ui.chapterWord} 02</p>
          <h2 id="priests-title" data-reveal="fade-up">{c.priests_commissioners.title}</h2>
          <p class="chapter-lede serif-italic" data-reveal="fade-up">
            {c.priests_commissioners.subHeading}
          </p>
        </header>
        <div class="priests-grid">
          <div class="chapter-prose prose-drop" data-reveal="fade-up">
            <p set:html={c.priests_commissioners.description1} />
            <p set:html={c.priests_commissioners.description2} />
            <p set:html={c.priests_commissioners.description3} />
            <p set:html={c.priests_commissioners.description4} />
            <p set:html={c.priests_commissioners.description5} />
            <p set:html={c.priests_commissioners.description6} />
            <p set:html={c.priests_commissioners.description7} />
            <p set:html={c.priests_commissioners.description8} />
          </div>
          <div class="priests-figs">
            {
              priestsFigs.map((f) => (
                <figure class="fig" data-reveal="fade-up">
                  <a href={f.full} data-lightbox="priests" data-caption={f.caption}>
                    <SmartImage
                      src={f.img}
                      alt={f.caption}
                      sizes="(min-width: 64rem) 20rem, 86vw"
                      widths={[400, 700]}
                      aspect="3 / 4"
                    />
                  </a>
                  <figcaption class="fig-caption serif-italic">{f.caption}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ============ 03 EXTINÇÃO ============ -->
      <section class="chapter" id="extinction" aria-labelledby="extinction-title">
        <header class="chapter-head">
          <p class="label" data-reveal="fade-up">{c.ui.chapterWord} 03</p>
          <h2 id="extinction-title" data-reveal="fade-up">{c.extinction.title}</h2>
          <p class="chapter-lede serif-italic" data-reveal="fade-up">{c.extinction.subHeading}</p>
        </header>
        <div class="chapter-prose prose-drop" data-reveal="fade-up">
          <p set:html={c.extinction.description1} />
          <p set:html={c.extinction.description2} />
          <p set:html={c.extinction.description3} />
        </div>

        <h3 class="strip-title serif-italic" data-reveal="fade-up">
          {c.ui.breveStripTitle}
        </h3>
        <GalleryStrip items={breveItems} lightbox="breve" aspect="3 / 4" class="docs-strip" />

        <h3 class="strip-title serif-italic" data-reveal="fade-up">{c.ui.receitaStripTitle}</h3>
        <GalleryStrip items={receitaItems} lightbox="receita" aspect="3 / 4" class="docs-strip" />
      </section>

      <!-- ============ 04 VENDA ============ -->
      <section class="chapter" id="sale" aria-labelledby="sale-title">
        <header class="chapter-head">
          <p class="label" data-reveal="fade-up">{c.ui.chapterWord} 04</p>
          <h2 id="sale-title" data-reveal="fade-up">{c.sale.title}</h2>
          <p class="chapter-lede serif-italic" data-reveal="fade-up">{c.sale.subHeading}</p>
        </header>
        <div class="priests-grid">
          <div class="chapter-prose prose-drop" data-reveal="fade-up">
            <p set:html={c.sale.description1} />
            <p set:html={c.sale.description2} />
            <p set:html={c.sale.description3} />
          </div>
          <div class="priests-figs">
            {
              saleFigs.map((f) => (
                <figure class="fig" data-reveal="fade-up">
                  <a href={f.full} data-lightbox="sale" data-caption={f.caption}>
                    <SmartImage
                      src={f.img}
                      alt={f.caption}
                      sizes="(min-width: 64rem) 20rem, 86vw"
                      widths={[400, 700]}
                      aspect="3 / 4"
                    />
                  </a>
                  <figcaption class="fig-caption serif-italic">{f.caption}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ============ 05 FIGURAS DE RELEVO ============ -->
      <section class="chapter" id="notable" aria-labelledby="notable-title">
        <header class="chapter-head">
          <p class="label" data-reveal="fade-up">{c.ui.chapterWord} 05</p>
          <h2 id="notable-title" data-reveal="fade-up">{c.notable_people.title}</h2>
          <p class="chapter-lede serif-italic" data-reveal="fade-up">
            {c.notable_people.subHeading}
          </p>
        </header>

        <!-- Camilo -->
        <article class="person">
          <header class="person-head" data-reveal="fade-up">
            <h3>{c.notable_people.camilo.title}</h3>
            <p class="label">{c.notable_people.camilo.subHeading}</p>
          </header>
          <div class="person-grid">
            <div class="chapter-prose" data-reveal="fade-up">
              <p set:html={c.notable_people.camilo.description1} />
              <p set:html={c.notable_people.camilo.description2} />
            </div>
            <div class="person-figs person-figs--stack">
              {
                camiloFigs.map((f, i) => (
                  <figure class="fig" data-reveal="fade-up">
                    <a href={f.full} data-lightbox="camilo" data-caption={f.caption}>
                      <SmartImage
                        src={f.img}
                        alt={i === 0 ? f.caption : c.ui.camiloLetterAlt.replace("{n}", String(i))}
                        sizes="(min-width: 64rem) 26rem, 86vw"
                        widths={[400, 700, 1000]}
                      />
                    </a>
                    <figcaption class="fig-caption serif-italic">{f.caption}</figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </article>

        <!-- Alberto -->
        <article class="person">
          <header class="person-head" data-reveal="fade-up">
            <h3>{c.notable_people.alberto.title}</h3>
            <p class="label">{c.notable_people.alberto.subHeading}</p>
          </header>
          <div class="person-grid">
            <div class="chapter-prose" data-reveal="fade-up">
              <p set:html={c.notable_people.alberto.description1} />
            </div>
            <div class="person-figs">
              {
                albertoFigs.map((f) => (
                  <figure class="fig" data-reveal="fade-up">
                    <a href={f.full} data-lightbox="alberto" data-caption={f.caption}>
                      <SmartImage
                        src={f.img}
                        alt={f.caption}
                        sizes="(min-width: 64rem) 13rem, 44vw"
                        widths={[300, 500, 800]}
                        aspect="3 / 4"
                      />
                    </a>
                    <figcaption class="fig-caption serif-italic">{f.caption}</figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </article>

        <!-- Sebastião -->
        <article class="person">
          <header class="person-head" data-reveal="fade-up">
            <h3>{c.notable_people.sebastiao.title}</h3>
            <p class="label">{c.notable_people.sebastiao.subHeading}</p>
          </header>
          <div class="person-grid">
            <div class="chapter-prose" data-reveal="fade-up">
              <p set:html={c.notable_people.sebastiao.description1} />
              <details class="poem-details">
                <summary>
                  <span class="serif-italic">{c.ui.readPoem} “{c.notable_people.sebastiao.poemTitle}”</span>
                </summary>
                <pre class="poem-full">{c.notable_people.sebastiao.poem}</pre>
              </details>
            </div>
            <div class="person-figs">
              {
                sebastiaoFigs.map((f) => (
                  <figure class="fig" data-reveal="fade-up">
                    <a href={f.full} data-lightbox="sebastiao" data-caption={f.caption}>
                      <SmartImage
                        src={f.img}
                        alt={f.caption}
                        sizes="(min-width: 64rem) 13rem, 44vw"
                        widths={[300, 500, 800]}
                        aspect="3 / 4"
                      />
                    </a>
                    <figcaption class="fig-caption serif-italic">{f.caption}</figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </article>
      </section>

      <!-- ============ 06 LIVRO ============ -->
      <section class="chapter" id="book" aria-labelledby="book-title">
        <header class="chapter-head">
          <p class="label" data-reveal="fade-up">{c.ui.chapterWord} 06</p>
          <h2 id="book-title" data-reveal="fade-up">{c.book.title}</h2>
        </header>
        <div class="book-layout">
          <div class="book-text">
            <h3 class="book-title serif-italic" data-reveal="fade-up">{c.book.subHeading}</h3>
            <p class="label" data-reveal="fade-up">{c.book.subSubHeading}</p>
            <p class="label book-publisher" data-reveal="fade-up">{c.book.subSubSubHeading}</p>
            <blockquote class="book-quote" data-reveal="fade-up">
              <p>{c.book.quote}</p>
            </blockquote>
          </div>
          <div class="book-images">
            <figure class="fig book-cover" data-reveal="mask">
              <a href={bookFull.src} data-lightbox="book" data-caption={c.book.imagesCaptions.book1}>
                <SmartImage
                  src={book1}
                  alt={c.book.imagesCaptions.book1}
                  sizes="(min-width: 64rem) 20rem, 70vw"
                  widths={[400, 700, 1000]}
                />
              </a>
            </figure>
            <figure class="fig book-old" data-reveal="fade-up">
              <SmartImage
                src={bookOld}
                alt={c.ui.bookOldAlt}
                sizes="(min-width: 64rem) 14rem, 50vw"
                widths={[300, 500, 800]}
              />
            </figure>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- ============ FLOATING CHAPTER WIDGET (mobile / tablet) ============ -->
  <div class="chapters-fab" data-open="false">
    <div id="chapters-fab-panel" class="chapters-fab-panel" role="menu" aria-label={c.ui.chaptersNavLabel}>
      <p class="label chapters-fab-heading">{c.ui.chaptersTitle}</p>
      <ol>
        {
          chapters.map((ch, i) => (
            <li role="none">
              <a role="menuitem" href={`#${ch.id}`} data-chapter={ch.id} data-fab-link>
                <span class="label">{String(i + 1).padStart(2, "0")}</span>
                <span class="chapters-fab-text">{ch.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <button
      id="chapters-fab-btn"
      class="chapters-fab-btn"
      type="button"
      aria-expanded="false"
      aria-controls="chapters-fab-panel"
      aria-label={c.ui.fabOpenAria}
    >
      <svg class="icon-list" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"></path>
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
      <span class="chapters-fab-current label">{c.ui.chaptersTitle}</span>
    </button>
  </div>

  <button id="to-top" class="to-top" type="button" aria-label={c.ui.backToTopAria}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
  </button>

  <Lightbox />
</BaseLayout>

<style>
  .history-layout {
    width: min(100% - 2 * var(--gutter), var(--container-wide));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(13rem, 16rem) minmax(0, 1fr);
    gap: var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
  }

  /* Content column must be allowed to shrink below its content's intrinsic
     width, otherwise wide children (images, <pre>) push the page sideways. */
  .chapters-content {
    min-width: 0;
  }

  /* ---- Side nav ---- */
  .chapters-nav {
    position: sticky;
    top: 6rem;
    align-self: start;
    padding-top: var(--space-sm);
  }

  .chapters-nav-title {
    color: var(--clay-deep);
    margin-bottom: var(--space-xs);
  }

  .chapters-nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--hairline);
  }

  .chapters-nav a {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.55rem 0 0.55rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--fg-soft);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .chapters-nav a .label {
    color: var(--gold-ink);
  }

  .chapters-nav a:hover,
  .chapters-nav a.is-active {
    color: var(--fg);
    border-left-color: var(--clay);
  }

  /* ---- Chapters ---- */
  .chapter {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: 5.5rem;
  }

  .chapter:last-child {
    border-bottom: none;
  }

  .chapter-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-md);
  }

  .chapter-head .label {
    color: var(--clay-deep);
  }

  .chapter-head h2 {
    font-size: var(--text-xl);
    font-weight: 420;
  }

  .chapter-lede {
    color: var(--fg-soft);
    font-size: var(--text-md);
    max-width: 52ch;
  }

  .chapter-prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: var(--fg-soft);
    max-width: 70ch;
    min-width: 0;
  }

  .chapter-prose :global(b) {
    color: var(--fg);
    font-weight: 700;
  }

  .chapter-prose :global(i) {
    font-family: var(--font-display);
    font-style: italic;
  }

  /* Drop cap on first paragraph */
  .prose-drop > p:first-child::first-letter {
    float: left;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 3.6em;
    line-height: 0.8;
    padding-right: 0.14em;
    color: var(--clay-deep);
  }

  /* ---- Figures ---- */
  .fig {
    margin: 0;
    min-width: 0;
    max-width: 100%;
  }

  .fig a {
    display: block;
  }

  .fig :global(.smart-image) {
    border-radius: var(--radius-sm);
    max-width: 100%;
  }

  .fig-caption {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
    color: var(--fg-soft);
    line-height: 1.5;
  }

  .fig-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .priests-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    gap: var(--space-lg);
    align-items: start;
  }

  .priests-grid > * {
    min-width: 0;
  }

  .priests-figs {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: sticky;
    top: 6rem;
  }

  .strip-title {
    margin: var(--space-lg) 0 var(--space-sm);
    font-size: var(--text-lg);
    font-weight: 440;
    color: var(--clay-deep);
  }

  .docs-strip :global(.strip-track) {
    padding-inline: 0;
  }

  /* ---- People ---- */
  .person {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px dashed var(--hairline);
  }

  .person-head h3 {
    font-size: var(--text-lg);
    font-weight: 440;
  }

  .person-head .label {
    color: var(--clay-deep);
    margin-top: 0.3rem;
    margin-bottom: var(--space-sm);
  }

  .person-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 28rem);
    gap: var(--space-lg);
    align-items: start;
  }

  .person-grid > * {
    min-width: 0;
  }

  .person-figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: var(--space-xs);
    position: sticky;
    top: 6rem;
  }

  .person-figs--stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: static;
    top: auto;
  }

  .poem-details {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--bg-alt);
    padding: var(--space-xs) var(--space-sm);
  }

  .poem-details summary {
    cursor: pointer;
    color: var(--clay-deep);
    font-size: var(--text-md);
  }

  .poem-full {
    margin: var(--space-sm) 0 0;
    white-space: pre-line;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--fg-soft);
    overflow-x: auto;
    max-width: 100%;
  }

  /* ---- Book chapter 6 — text first, images second ---- */
  .book-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .book-images {
    display: flex;
    gap: var(--space-md);
    align-items: flex-end;
    flex-wrap: wrap;
    --book-h: clamp(15rem, 30vw, 23rem);
  }

  .book-cover,
  .book-old {
    flex: 0 0 auto;
    height: var(--book-h);
  }

  .book-cover a {
    display: inline-block;
    height: 100%;
  }

  .book-cover :global(.smart-image),
  .book-old :global(.smart-image) {
    display: inline-block;
    height: 100%;
    width: auto;
    aspect-ratio: auto !important;
  }

  .book-cover :global(picture),
  .book-old :global(picture) {
    height: 100%;
    width: auto;
  }

  .book-cover :global(img),
  .book-old :global(img) {
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  /* ---- Book ---- */
  .book-title {
    font-size: var(--text-lg);
    font-weight: 440;
    margin-bottom: 0.5rem;
  }

  .book-publisher {
    color: var(--clay-deep);
    margin-bottom: var(--space-sm);
  }

  .book-quote {
    margin: var(--space-sm) 0 0;
    padding-left: var(--space-sm);
    border-left: 2px solid var(--clay);
  }

  .book-quote p {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--fg-soft);
    line-height: 1.7;
  }

  /* ---- To top ---- */
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 90;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--parchment);
    color: var(--clay-deep);
    display: grid;
    place-items: center;
    padding: 0.75rem;
    opacity: 0;
    pointer-events: none;
    translate: 0 0.6rem;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out);
  }

  .to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    translate: 0 0;
  }

  /* ---- Floating chapters widget (hidden on desktop) ---- */
  .chapters-fab {
    display: none;
  }

  /* ---- Responsive ---- */
  @media (max-width: 80rem) {
    .history-layout {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    /* Side nav is replaced by the floating widget below this width */
    .chapters-nav {
      display: none;
    }

    .chapters-fab {
      display: block;
      position: fixed;
      left: clamp(1rem, 3vw, 2rem);
      bottom: clamp(1rem, 3vw, 2rem);
      z-index: 90;
    }

    .chapters-fab-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      height: 2.9rem;
      padding-inline: 1rem;
      border-radius: 999rem;
      border: 1px solid var(--hairline);
      background: var(--parchment);
      color: var(--clay-deep);
      font-family: var(--font-body);
      cursor: pointer;
      box-shadow: 0 6px 22px -12px rgb(0 0 0 / 0.45);
      transition:
        background var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }

    .chapters-fab-btn svg {
      width: 1.15rem;
      height: 1.15rem;
      flex: none;
    }

    .chapters-fab-btn .icon-close {
      display: none;
    }

    .chapters-fab[data-open="true"] .chapters-fab-btn .icon-list {
      display: none;
    }

    .chapters-fab[data-open="true"] .chapters-fab-btn .icon-close {
      display: block;
    }

    .chapters-fab-current {
      white-space: nowrap;
    }

    .chapters-fab-panel {
      position: absolute;
      bottom: calc(100% + 0.6rem);
      left: 0;
      min-width: min(18rem, 78vw);
      max-height: min(60vh, 30rem);
      overflow-y: auto;
      padding: var(--space-sm);
      border-radius: var(--radius-sm);
      border: 1px solid var(--hairline);
      background: var(--bg);
      box-shadow: 0 18px 48px -20px rgb(0 0 0 / 0.5);
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.6rem);
      transition:
        opacity var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out),
        visibility 0s linear var(--dur-fast);
    }

    .chapters-fab[data-open="true"] .chapters-fab-panel {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out);
    }

    .chapters-fab-heading {
      color: var(--clay-deep);
      margin-bottom: var(--space-xs);
    }

    .chapters-fab-panel ol {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .chapters-fab-panel a {
      display: flex;
      align-items: baseline;
      gap: 0.7rem;
      padding: 0.55rem 0.4rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: var(--text-base);
      color: var(--fg-soft);
      transition:
        color var(--dur-fast) var(--ease-out),
        background var(--dur-fast) var(--ease-out);
    }

    .chapters-fab-panel a .label {
      color: var(--gold-ink);
    }

    .chapters-fab-panel a:hover,
    .chapters-fab-panel a.is-active {
      color: var(--fg);
      background: var(--bg-alt);
    }
  }

  @media (max-width: 64rem) {
    .priests-grid,
    .person-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .priests-figs,
    .person-figs {
      position: static;
      top: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm);
    }

    .priests-figs {
      max-width: 32rem;
    }
  }

  @media (max-width: 34rem) {
    .fig-grid {
      grid-template-columns: 1fr;
    }

    .chapter-prose {
      max-width: none;
    }

    .prose-drop > p:first-child::first-letter {
      font-size: 3em;
    }

    /* Book images: drive sizing by width (not a fixed height) so they
       shrink with the viewport and stack instead of overflowing. */
    .book-images {
      flex-direction: column;
      align-items: stretch;
      --book-h: auto;
    }

    .book-cover,
    .book-old {
      height: auto;
      width: 100%;
      max-width: 18rem;
    }

    .book-cover a,
    .book-cover :global(.smart-image),
    .book-old :global(.smart-image),
    .book-cover :global(picture),
    .book-old :global(picture),
    .book-cover :global(img),
    .book-old :global(img) {
      height: auto;
      width: 100%;
    }

    .person-figs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .poem-full {
      font-size: var(--text-sm);
      line-height: 1.7;
    }
  }
</style>

<script>
  function initHistoryPage() {
    const list = document.getElementById("chapters-list");
    if (!list || list.dataset.bound) return;
    list.dataset.bound = "true";

    /* Active chapter highlighting (desktop nav + floating widget) */
    const links = new Map<string, HTMLAnchorElement[]>();
    document.querySelectorAll<HTMLAnchorElement>("a[data-chapter]").forEach((a) => {
      const key = a.dataset.chapter!;
      if (!links.has(key)) links.set(key, []);
      links.get(key)!.push(a);
    });

    const fabCurrent = document.querySelector<HTMLElement>(".chapters-fab-current");
    const setActive = (id: string) => {
      links.forEach((group) => group.forEach((a) => a.classList.remove("is-active")));
      links.get(id)?.forEach((a) => a.classList.add("is-active"));
      const label = links.get(id)?.[0]?.querySelector(".chapters-fab-text")?.textContent;
      if (fabCurrent && label) fabCurrent.textContent = label;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: "-20% 0px -65% 0px" },
    );

    document.querySelectorAll(".chapter[id]").forEach((s) => observer.observe(s));

    /* To-top button */
    const toTop = document.getElementById("to-top");
    if (toTop) {
      const onScroll = () => {
        toTop.classList.toggle("is-visible", window.scrollY > window.innerHeight * 1.2);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      toTop.addEventListener("click", () => {
        const lenis = window.__lenis;
        if (lenis) lenis.scrollTo(0);
        else window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    /* Floating chapters widget */
    const fab = document.querySelector<HTMLElement>(".chapters-fab");
    const fabBtn = document.getElementById("chapters-fab-btn");
    if (fab && fabBtn) {
      const setOpen = (open: boolean) => {
        fab.dataset.open = String(open);
        fabBtn.setAttribute("aria-expanded", String(open));
      };

      fabBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(fab.dataset.open !== "true");
      });

      fab.querySelectorAll<HTMLAnchorElement>("a[data-fab-link]").forEach((a) => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          const id = a.dataset.chapter!;
          const target = document.getElementById(id);
          setOpen(false);
          if (!target) return;
          const lenis = window.__lenis;
          if (lenis) lenis.scrollTo(target, { offset: -88 });
          else target.scrollIntoView({ behavior: "smooth" });
        });
      });

      document.addEventListener("click", (e) => {
        if (fab.dataset.open === "true" && !fab.contains(e.target as Node)) setOpen(false);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    }

    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });

  }

  initHistoryPage();
  document.addEventListener("astro:page-load", initHistoryPage);
</script>
