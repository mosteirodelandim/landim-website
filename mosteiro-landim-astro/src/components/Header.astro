---
interface Props {
  tone?: "light" | "dark";
}

const { tone = "light" } = Astro.props;
---

<header id="site-header" class:list={["site-header", `tone-${tone}`]}>
  <a class="brand" href="/">
    <span class="brand-mark serif-italic">ML</span>
    <span class="brand-name">Mosteiro de Landim</span>
  </a>

  <button
    id="menu-toggle"
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="menu-overlay"
  >
    <span class="menu-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    <span class="menu-toggle-text label">Menu</span>
  </button>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: clamp(0.9rem, 2vw, 1.4rem) var(--gutter);
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      padding var(--dur-base) var(--ease-out);
  }

  .tone-light {
    color: var(--linen);
  }

  .tone-dark {
    color: var(--espresso);
  }

  .site-header.is-scrolled {
    color: var(--espresso);
    background: color-mix(in oklab, var(--linen) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--hairline);
    padding-block: 0.65rem;
  }

  /* While the menu overlay is open the header rises above it and darkens */
  .site-header.menu-open {
    z-index: calc(var(--z-menu) + 1);
    color: var(--espresso);
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .brand:hover {
    color: inherit;
  }

  .brand-mark {
    font-size: 1.5rem;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    padding: 0.4rem 0;
  }

  .menu-toggle-text {
    color: inherit;
  }

  .menu-toggle-lines {
    display: inline-flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 2rem;
  }

  .menu-toggle-lines i {
    display: block;
    height: 1px;
    background: currentcolor;
    transition: transform var(--dur-base) var(--ease-out), width var(--dur-base) var(--ease-out);
  }

  .menu-toggle-lines i:last-child {
    width: 70%;
    align-self: flex-end;
  }

  .menu-toggle:hover .menu-toggle-lines i:last-child {
    width: 100%;
  }

  @media (max-width: 48rem) {
    .brand-name {
      display: none;
    }

    .brand-mark {
      font-size: 1.8rem;
    }
  }
</style>
