---
import { navLinks } from "@/data/nav";
import { config } from "@/config";
import { t } from "@/i18n";

const year = new Date().getFullYear();

const socialIcons: Record<string, string> = {
  Instagram:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg>',
  Facebook:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 8h2.5V4.5H14A4.5 4.5 0 0 0 9.5 9v2.5H7V15h2.5v6H13v-6h2.5l.5-3.5h-3V9a1 1 0 0 1 1-1Z"/></svg>',
  Pinterest:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7c-2.2 0-4 1.6-4 3.8 0 1.4.6 2.4 1.7 2.9l.5-1.7c-.3-.4-.5-.8-.5-1.3 0-1.2 1-2.2 2.3-2.2 1.2 0 2 .8 2 2 0 1.5-.7 2.8-1.8 2.8-.6 0-1-.5-.9-1.1l.6-2.1-1 6.4c-.1.6-.1 1.3 0 1.9"/></svg>',
};
---

<footer class="site-footer theme-dark">
  <div class="container footer-inner">
    <div class="footer-top">
      <p class="footer-logotype">
        Mosteiro <span class="serif-italic">de</span> Landim
      </p>
      <p class="footer-tagline">{t.landing.subHeading}<span class="serif-italic">de família.</span></p>
    </div>

    <div class="footer-grid">
      <nav class="footer-col" aria-label="Rodapé — navegação">
        <p class="label">Explorar</p>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <p class="label">Contactos</p>
        <ul>
          <li><a href={`mailto:${config.emailContact}`}>{config.emailContact}</a></li>
          <li>
            <a href={`tel:${config.phoneContact.replace(/\s/g, "")}`}>{config.phoneContact}</a>
          </li>
          <li class="footer-address">{config.address}</li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="label">Seguir</p>
        <ul class="footer-social">
          {
            config.socialLinks.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <span class="footer-social-icon" set:html={socialIcons[s.name]} />
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Mosteiro de Landim · {t.landing.footer}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--moss);
    color: var(--linen);
    padding: var(--space-xl) 0 var(--space-md);
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-logotype {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    margin-top: 0.6rem;
    color: color-mix(in oklab, var(--linen) 82%, var(--moss));
    font-size: var(--text-md);
  }

  .footer-tagline .serif-italic {
    color: var(--rose);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline-dark);
  }

  .footer-col .label {
    color: var(--rose);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-col a {
    text-decoration: none;
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--linen) 90%, var(--moss));
  }

  .footer-col a:hover {
    color: var(--linen);
    text-decoration: underline;
  }

  .footer-address {
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--linen) 80%, var(--moss));
    max-width: 16rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-social-icon {
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
  }

  .footer-social-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline-dark);
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--linen) 78%, var(--moss));
  }

  .footer-bottom .label {
    color: inherit;
  }

  @media (max-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }
</style>
