---
/**
 * Editorial cross-link band — award-winning take:
 * large italic display title, minimal celestial SVG ornament, sleek grid.
 * `icon` swaps the central glyph (frame stays identical across uses).
 */
type SpotlightIcon =
  | "history"
  | "wine"
  | "events"
  | "stay"
  | "gardens"
  | "social"
  | "star";

interface Props {
  label: string;
  text: string;
  /** Retained for caller compatibility; no longer rendered inline. */
  linkText?: string;
  /** Button label. */
  cta?: string;
  href: string;
  external?: boolean;
  icon?: SpotlightIcon;
  class?: string;
}

const {
  label,
  text,
  cta = "Saber mais",
  href,
  external = false,
  icon = "star",
  class: className = "",
} = Astro.props;

// Central glyphs — drawn in the same line-art style, centred on (44,44).
const glyphs: Record<SpotlightIcon, string> = {
  star: `<path d="M44 26 l2.8 -10 2.8 10 10 2.8 -10 2.8 -2.8 10 -2.8 -10 -10 -2.8Z" stroke="currentColor" stroke-width="0.7" fill="none" opacity="0.6"/><circle cx="44" cy="44" r="5" stroke="currentColor" stroke-width="0.7" opacity="0.55"/>`,
  history: `<path d="M44 33 C39.5 30.5 32.5 30.5 28.5 32.8 L28.5 55 C32.5 52.7 39.5 52.7 44 55 C48.5 52.7 55.5 52.7 59.5 55 L59.5 32.8 C55.5 30.5 48.5 30.5 44 33 Z" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><path d="M44 33 L44 55" stroke="currentColor" stroke-width="0.7" opacity="0.5"/>`,
  wine: `<path d="M40.5 27 L47.5 27 L47.5 35.5 C50.3 38.5 51.3 41.5 51.3 47 L51.3 60 L36.7 60 L36.7 47 C36.7 41.5 37.7 38.5 40.5 35.5 Z" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><path d="M36.7 49 L51.3 49" stroke="currentColor" stroke-width="0.7" opacity="0.45"/>`,
  events: `<path d="M37 28 L43 28 L41.5 42 Q41 45 40.7 48 L40.7 58 M37.5 58 L43.9 58" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><path d="M45 28 L51 28 L49.5 42 Q49 45 48.7 48 L48.7 58 M45.5 58 L51.9 58" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><path d="M44 20 l1.4 -4 1.4 4 4 1.4 -4 1.4 -1.4 4 -1.4 -4 -4 -1.4Z" fill="currentColor" opacity="0.5"/>`,
  stay: `<circle cx="44" cy="33" r="6" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><path d="M44 39 L44 59 M44 51 L49.5 51 M44 55 L47.5 55" stroke="currentColor" stroke-width="0.8" opacity="0.6"/>`,
  gardens: `<path d="M44 27 C54 33.5 54 50.5 44 60 C34 50.5 34 33.5 44 27 Z" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><path d="M44 31 L44 58 M44 42 L38.5 38 M44 47 L49.5 43" stroke="currentColor" stroke-width="0.7" opacity="0.5"/>`,
  social: `<rect x="32.5" y="32.5" width="23" height="23" rx="7" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><circle cx="44" cy="44" r="7" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.6"/><circle cx="51" cy="37" r="1.6" fill="currentColor" opacity="0.5"/>`,
};

const glyph = glyphs[icon];
---

<aside class:list={["spotlight", className]} data-reveal="fade-up">
  <!-- Oversized decorative SVG ornament bleeding off the left edge -->
  <div class="spotlight-bg" aria-hidden="true">
    <svg viewBox="0 0 88 88" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="44" cy="44" r="40" stroke="currentColor" stroke-width="0.7" stroke-dasharray="3 6" opacity="0.5"/>
      <circle cx="44" cy="44" r="30" stroke="currentColor" stroke-width="0.5" opacity="0.35"/>
      <path d="M44 4 L44 0 M44 88 L44 84 M4 44 L0 44 M88 44 L84 44" stroke="currentColor" stroke-width="0.8" opacity="0.6"/>
      <g set:html={glyph} />
      <circle cx="72.5" cy="15.5" r="1.6" fill="currentColor" opacity="0.5"/>
      <circle cx="15.5" cy="72.5" r="1.6" fill="currentColor" opacity="0.5"/>
    </svg>
  </div>

  <div class="container spotlight-inner">
    <div class="spotlight-content">
      <h2 class="spotlight-title serif-italic">{label}</h2>
      <p class="spotlight-text">{text}</p>
    </div>

    <a
      class="spotlight-cta"
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
    >
      <span>{cta}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M4 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</aside>

<style>
  .spotlight {
    position: relative;
    border-block: 1px solid var(--hairline);
    background: var(--bg-alt);
    padding-block: var(--space-xl);
    margin-block: var(--space-lg);
    overflow: clip;
  }

  /* Merge seamlessly with the section directly above (same bg) */
  .spotlight--flush {
    border-block-start: 0;
    margin-block-start: 0;
    padding-block-start: 0;
    margin-top: calc(var(--space-lg) * 1);
  }

  /* No trailing gap before the footer */
  .spotlight:last-of-type {
    margin-block-end: 0;
  }

  /* Oversized ornament bleeding off the left edge as a backdrop */
  .spotlight-bg {
    position: absolute;
    top: 50%;
    left: 0;
    width: clamp(20rem, 38vw, 34rem);
    aspect-ratio: 1;
    transform: translate(-32%, -50%);
    color: var(--clay);
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }

  .spotlight-bg svg {
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    transition: transform 0.9s var(--ease-out);
  }

  .spotlight:hover .spotlight-bg svg {
    transform: rotate(30deg);
  }

  .spotlight-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .spotlight-content {
    flex: 1 1 26rem;
    padding-left: clamp(0rem, 6vw, 5rem);
  }

  .spotlight-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--clay-deep);
    line-height: 1.05;
    margin-bottom: 0.7rem;
    letter-spacing: -0.015em;
  }

  .spotlight-text {
    font-size: var(--text-md);
    color: var(--fg-soft);
    max-width: 54ch;
    line-height: 1.6;
  }

  .spotlight-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    border: 1px solid var(--clay);
    background: transparent;
    color: var(--clay-deep);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .spotlight-cta svg {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .spotlight-cta:hover {
    background: var(--clay);
    color: var(--linen);
  }

  .spotlight:hover .spotlight-cta {
    background: var(--clay);
    border-color: var(--clay);
    color: var(--linen);
  }

  .spotlight-cta:hover svg {
    transform: translateX(0.3rem);
  }

  .spotlight:hover .spotlight-cta svg {
    transform: translateX(0.3rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight:hover .spotlight-bg svg {
      transform: none;
    }
  }

  @media (max-width: 48rem) {
    .spotlight {
      padding-block: var(--space-lg);
    }

    .spotlight-content {
      padding-left: 0;
    }

    .spotlight-bg {
      width: 22rem;
      transform: translate(-42%, -50%);
      opacity: 0.1;
    }
  }
</style>
